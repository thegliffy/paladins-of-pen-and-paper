; Engine configuration file.
; Godot 4.7 — https://godotengine.org

config_version=5

[application]

config/name="Paladins of Pen and Paper"
config/description="A tabletop-framed pixel RPG. Phase 0 playable slice."
config/version="0.2.6"
boot_splash/bg_color=Color(0.12, 0.08, 0.05, 1)
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/icon.png"

[autoload]

ContentDB="*res://scripts/autoload/content_db.gd"
GameState="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=270
window/size/viewport_height=480
window/size/window_width_override=810
window/size/window_height_override=1440
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.08, 0.05, 1)

[gui]

theme/default_font_antialiasing=0

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
